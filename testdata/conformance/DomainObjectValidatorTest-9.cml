
			ContextMap {
				contains ContextA, ContextB
				
				ContextA <-> ContextB
			}
			BoundedContext ContextA {
				Aggregate TestAggregate1 {
					Entity TestEntity
				}
			}
			BoundedContext ContextB {
				Aggregate TestAggregate2 {
					Entity TestEntity2 {
						- TestEntity ref
					}
				}
			}
		